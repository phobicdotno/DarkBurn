# The web page, the two scripts that build and upload it and two files the build copies are
# read byte for byte (by sh, and by the build's own checks), so they keep Unix line ends in
# every checkout, also on Windows. In a checkout made before this file existed: delete these
# files and check them out again.
/site/*.html text eol=lf
/site/*.css text eol=lf
/site/*.js text eol=lf
/site/.htaccess text eol=lf
/scripts/build-site.sh text eol=lf
/scripts/deploy-site.sh text eol=lf
/assets/icons/ui/design/svg/model/db_app.svg text eol=lf
/assets/fonts/ibm-plex-sans/OFL.txt text eol=lf
